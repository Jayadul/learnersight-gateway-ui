{
  "info": {
    "_postman_id": "a1b2c3d4-0000-0000-0000-000000000002",
    "name": "NetZeroGateway API",
    "description": "Multi-channel messaging gateway — SMS, WhatsApp, Voice with automatic fallback.\n\n**Setup:** Import the environment file, run \"Login (admin)\" first — it auto-saves tokens.\n\n**No auth on /sendtext** — the gateway endpoint is open (consumed by internal services).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [""]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('accessToken', json.accessToken);",
                  "    pm.environment.set('refreshToken', json.refreshToken);",
                  "    pm.test('Login successful — tokens saved', function () {",
                  "        pm.expect(json.accessToken).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Login (operator)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('accessToken', json.accessToken);",
                  "    pm.environment.set('refreshToken', json.refreshToken);",
                  "    pm.test('Login successful — tokens saved', function () {",
                  "        pm.expect(json.accessToken).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"operator\",\n  \"password\": \"Operator@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.environment.set('accessToken', json.accessToken);",
                  "    pm.environment.set('refreshToken', json.refreshToken);",
                  "    pm.test('Tokens refreshed', function () {",
                  "        pm.expect(json.accessToken).to.be.a('string');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Gateway",
      "description": "POST /sendtext — no auth required. Parses channel tags from messageContent and dispatches to SMS, WhatsApp, Voice with automatic fallback.",
      "item": [
        {
          "name": "SendText — All Channels (full test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.Message_ID) {",
                  "    pm.environment.set('messageRequestId', json.Message_ID);",
                  "}",
                  "pm.test('Status is ACCEPTD', function () {",
                  "    pm.expect(json.Status).to.eql('0');",
                  "    pm.expect(json.Text).to.eql('ACCEPTD');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "callerID", "value": "123", "type": "text" },
                { "key": "toUser", "value": "8801748848039", "type": "text" },
                { "key": "messageContent", "value": "[sms::Your OTP is 123456. It expires in 10 minutes.]  [wp::Hello John, your appointment is confirmed for tomorrow at 3:00 PM.]  [smswp::Book direct and save on every reservation. Visit https://hotel.example.com]  [wpmedia::Please review the attached invoice.||https://example.com/files/invoice.pdf]  [call::due-bill-api]", "type": "text" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/sendtext",
              "host": ["{{baseUrl}}"],
              "path": ["sendtext"]
            }
          }
        },
